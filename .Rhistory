# 표본크기가 작으면 signal과 noise를 구분하기 어렵다. 시뮬레이션으로 확인해보자.
# 시뮬레이션 파라미터
alpha <- 0.05
mu <- 0  # 효과가 없다고 가정. 즉, 영가설을 가정.
sd <- 1
n_init <- 10 # 최초 피험자 수
n_add <- 2 # p > .05일 때, 피험자 추가 단위
# 시뮬레이션 결과를 저장할 변수
Ps <- NULL  # p값
Ns <- NULL  # 피험자 수
Ds <- NULL  # 효과크기
# 일만 번 시뮬레이션 실시
# for 반복문
for (nexp in 1:1e4) {
x <- rnorm(n_init, mean = mu, sd = sd) # 실험 시작
# while 반복문
go <- TRUE
while (go) {
res <- t.test(x, mu = mu, alternative = "greater") # one-sample t-test
# 교재 41쪽. 등가설(nondirectional h.), 부등가설(directional h.)
# if-else 조건문
if (res$p.value < alpha) { # 통계적으로 유의하면 기록하고 실험 종료.
Ps <- append(Ps, res$p.value)
Ns <- append(Ns, length(x))
Ds <- append(Ds, abs(mean(x)/sd(x)))
go <- FALSE
} else { # 유의하지 않으면 피험자 추가.
x <- append(x, rnorm(n_add, mean = mu, sd = sd))
}
# if 조건문: 피험자가 200명을 넘으면 종료하고 잊어버린다.
if (length(x) > 200) {
go <- FALSE
}
simres <- data.frame(sample.size = Ns, effect.size = Ds, p.value = Ps)
head(simres)
tail(simres)
pairs.panels(simres1, stars = TRUE, smoother = TRUE,
ci = TRUE, ellipses = FALSE, scale = TRUE,
main=paste(format(length(Ns), big.mark = ",", scientific = FALSE),
'/10,000 samples', sep = ""))
pairs.panels(simres, stars = TRUE, smoother = TRUE,
ci = TRUE, ellipses = FALSE, scale = TRUE,
main=paste(format(length(Ns), big.mark = ",", scientific = FALSE),
'/10,000 samples', sep = ""))
pairs.panels(simres, stars = TRUE, smoother = FALSE,
ci = TRUE, ellipses = FALSE, scale = TRUE,
main=paste(format(length(Ns), big.mark = ",", scientific = FALSE),
'/10,000 samples', sep = ""))
