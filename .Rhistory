mu2 <- 100
sd2 <- 24
increment <- 1 # 무척 작은 효과
Plist <- list()
Nlist <- list()
# for 반복문
for (nexp in 1:10) {
x <- rnorm(n_init, mean = mu2 + increment, sd = sd2) # 실험 시작
Ps <- NULL # 이번 실험이 끝날 때까지 p값의 변화를 기록하자.
Ns <- NULL
# while 반복문
go <- TRUE
while (go) {
res <- t.test(x, mu = mu2, alternative = "greater")
Ps <- append(Ps, res$p.value)
Ns <- append(Ns, length(x))
# if-else 조건문
if (res$p.value < alpha) { # 통계적으로 유의하면 이번 실험 종료.
go <- FALSE
} else { # 유의하지 않으면, 피험자 한 명을 더 추가
x <- append(x, rnorm(1, mean = mu2 + increment, sd = sd2))
}
Plist <- append(Plist, list(Ps))
Nlist <- append(Nlist, list(Ns))
}
plot(NULL, ylab="P value", xlab="Sample Size (log)",
xlim=c(10, max(lengths(Plist))), ylim=c(0, 1),
log = "x")
for (nexp in 1:10) {
lines(Nlist[[nexp]], Plist[[nexp]], col = nexp)
}
abline(h=.05, col = 'red', lty=2)
max(lengths(Plist)))
